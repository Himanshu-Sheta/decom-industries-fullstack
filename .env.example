# ==============================================
# Decom Industries - Environment Variables Template
# Copy this file to `.env` for local development.
# NEVER commit your real `.env` file to Git!
# ==============================================

# --- PostgreSQL Database (Docker) ---
POSTGRES_USER=decom_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=decom_store
POSTGRES_PORT=5439
ADMINER_PORT=8081

# --- Backend API ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://decom_admin:change_me_strong_password@localhost:5439/decom_store?schema=public

# --- Security & Auth (JWT) ---
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS (Which Frontend URL is allowed to call the Backend) ---
FRONTEND_URL=http://localhost:3000

# --- Frontend Public API URL ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
